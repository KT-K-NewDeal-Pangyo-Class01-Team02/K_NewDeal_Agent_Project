# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 .gitignore 로 막혀 있습니다.

# BTL 기획서를 만들어 주는 n8n 웹훅 주소.
# 비워 두면 데모 모드로 뜨고, n8n 없이 샘플 기획안으로 화면 흐름만 확인합니다.
N8N_WEBHOOK_URL=https://fairytalegames.app.n8n.cloud/webhook/plan-gen

# F 기능 웹훅의 공통 앞부분. 여기에 f01-scan, f01-select 같은 경로를 붙여 부릅니다.
# 비워 두면 N8N_WEBHOOK_URL 에서 '/webhook' 까지를 잘라 씁니다.
N8N_BASE_URL=https://fairytalegames.app.n8n.cloud/webhook

# n8n 응답을 기다릴 최대 시간(초)
N8N_TIMEOUT=120

# 빅또리 앱이 뜰 포트 (Command Center 는 5000, 통하길 스튜디오는 5004)
VICDDORY_PORT=5500

# Command Center 홈 주소 (사이드바의 '홈' 링크가 여기로 갑니다)
COMMAND_CENTER_URL=http://localhost:5000

# 기획안 입지 이미지 자리의 "포스터 만들기" 링크 (통하길 스튜디오, 이승현).
# 스튜디오는 허브의 /studio/ 에 있습니다. 비워 두면 COMMAND_CENTER_URL 뒤에 /studio/ 를 붙입니다.
TONGHAGIL_URL=

# 지사 승인 화면(/hq)과 승인 · 반려 API 로그인. HQ_PASSWORD 를 비워 두면 승인 화면이 열리지 않습니다.
HQ_USER=hq
HQ_PASSWORD=

# 개발할 때만 1 (코드 자동 재시작, 오류 화면에 디버거). 공개 주소(ngrok)로 열 때는 비워 둡니다.
VICDDORY_DEBUG=
