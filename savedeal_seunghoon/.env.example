FLASK_DEBUG=1
DATA_DIR=data
PORT=5001
COMMAND_CENTER_URL=http://localhost:5000

# ── n8n → Gmail 알림 (비워 두면 데모 모드: 실제 발송 없이 기록만) ──
# n8n Webhook 노드의 운영 주소(Production URL, …/webhook/…)
N8N_WEBHOOK_URL=
# Webhook 의 Header Auth 값 (n8n 쪽과 같게)
N8N_WEBHOOK_SECRET=
N8N_SECRET_HEADER=X-SaveDeal-Key
N8N_TIMEOUT=8
# 알림 받을 메일 (비우면 n8n Gmail 노드에 적은 주소로 보냄)
NOTIFY_EMAIL_TO=

# ── 외부 이벤트 (개통 반려·입고 지연·서류 도착 등, docs/n8n_events_setup.md) ──
# n8n 이 POST /api/events 로 보내는 방식은 항상 켜져 있음. 외부(ngrok)에서 받으려면 위 N8N_WEBHOOK_SECRET 필수.
# 가져오기 모드: n8n 'SaveDeal 외부 이벤트 목록' Webhook 의 운영 주소 (비우면 끔)
N8N_EVENTS_URL=
EVENT_SYNC_SECONDS=60

# ── OpenAI (ChatGPT API) — 결제·크레딧이 필요. 비워 두면 AI 대신 규칙 기반 문구 사용 ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20
