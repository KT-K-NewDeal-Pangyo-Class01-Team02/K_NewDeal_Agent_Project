# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# --- Command Center (홈) ---
COMMAND_CENTER_PORT=5000
COMMAND_CENTER_URL=http://localhost:5000
CC_USER_NAME=김지현 매니저

# --- 통하길 스튜디오 ---
STUDIO_PORT=5004
# n8n 'When chat message received' 노드의 Chat URL. 비워 두면 데모 모드로 동작합니다.
# 예) https://<내-n8n-주소>/webhook/<id>/chat
N8N_WEBHOOK_URL=
N8N_TIMEOUT=180
