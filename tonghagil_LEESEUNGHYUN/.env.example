# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 통하길 스튜디오는 허브(command_center)와 같은 프로세스에서 돕니다. 이 .env 는 스튜디오만 읽습니다.
# (허브 설정 COMMAND_CENTER_PORT, CC_USER_NAME 은 command_center/.env 에 넣으세요)

# --- 통하길 스튜디오 ---
# n8n Webhook 노드의 운영 주소(Production URL). 비워 두면 데모 모드로 동작합니다.
# 예) https://<내-이름>.app.n8n.cloud/webhook/tonghagil-poster     (테스트 주소 /webhook-test/ 말고 /webhook/)
N8N_WEBHOOK_URL=
N8N_TIMEOUT=180
# n8n Webhook 의 Header Auth 와 같은 값. 헤더 이름은 N8N_SECRET_HEADER (기본 X-Tonghagil-Key)
N8N_WEBHOOK_SECRET=
N8N_SECRET_HEADER=X-Tonghagil-Key

# 갤러리로 쓸 구글 드라이브 폴더 ID (폴더 주소를 통째로 넣어도 됩니다). 비워 두면 샘플 포스터를 보여 줍니다.
# 예) https://drive.google.com/drive/folders/1AbCdEf... 의 1AbCdEf... 부분
DRIVE_FOLDER_ID=
# 서비스 계정 키(JSON) 경로. tonghagil_LEESEUNGHYUN 폴더 기준. 이 폴더(credentials/)는 git 에 올라가지 않습니다.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
# 드라이브 폴더 목록을 다시 읽기 전까지 기다리는 시간(초). 갤러리의 새로고침 버튼은 바로 다시 읽습니다.
DRIVE_CACHE_SECONDS=60

# --- 통하길 QR (/qr/) ---
# 카카오맵 JavaScript 키. 비워 두면 지도 화면이 그림 약도로 나옵니다. (발급 방법은 README '카카오맵 연결')
QR_KAKAO_MAP_KEY=
# 부스 담당자 화면(/qr/staff/) PIN. 비워 두면 1234 (시연용)
QR_STAFF_PIN=
# 방문객 기록(접속·스탬프·쿠폰) 보관 시간. 마지막 활동 뒤 이 시간이 지나면 자동 삭제. 비우면 24, 0 이면 삭제 안 함
QR_RETENTION_HOURS=24
# 사은품 뽑기 n8n Webhook 운영 주소 (구글 시트를 읽어 뽑고 수량을 1 줄이는 워크플로). 비워 두면 event.json 의 목록으로 뽑음
QR_GIFT_WEBHOOK_URL=
QR_GIFT_WEBHOOK_SECRET=
# 테스트용 QR(스탬프 5개를 한 번에 찍기)을 담당자 화면에 보여 줄지. 비우면 켜짐, 실제 행사에서는 0
QR_TEST_QR=
# QR 코드에 넣을 공개 주소. 비워 두면 지금 접속한 주소. ngrok 연결 후 예) https://<내 도메인>.ngrok-free.app
QR_PUBLIC_BASE_URL=
# 방문객 채팅 에이전트의 n8n Webhook 운영 주소. 비워 두면 고정 답변("테스트 단계입니다")
QR_CHAT_WEBHOOK_URL=
QR_CHAT_WEBHOOK_SECRET=
QR_CHAT_SECRET_HEADER=X-Tonghagil-Key
QR_CHAT_TIMEOUT=30
# 담당자 화면(/qr/staff/) 관리자 에이전트의 n8n Webhook 운영 주소 (방문객용과 다른 워크플로). 비워 두면 고정 답변
# 비밀 값을 비워 두면 위 QR_CHAT_WEBHOOK_SECRET 을 같이 씁니다.
QR_STAFF_CHAT_WEBHOOK_URL=
QR_STAFF_CHAT_WEBHOOK_SECRET=
