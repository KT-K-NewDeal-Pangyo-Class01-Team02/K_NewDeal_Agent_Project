# 더 줘 (thejo_project) 설정 예시.
# 이 파일을 복사해 같은 폴더에 `.env` 로 만들고 값을 채우세요. `.env` 는 git 에 올라가지 않습니다.
#
#   copy thejo_project\.env.example thejo_project\.env
#
# 설정이 없어도 동작합니다. 그때는 실제 문자를 보내지 않고 데모 성공을 돌려줍니다.

# 고객 안내 문자를 보낼 n8n 워크플로우의 Webhook URL.
# 비워 두면 데모 모드. 서버에서만 읽고 브라우저로는 절대 내려보내지 않습니다.
N8N_SMS_WEBHOOK_URL=

# n8n 응답을 기다릴 최대 시간(초). 기본 10.
N8N_SMS_TIMEOUT=10
